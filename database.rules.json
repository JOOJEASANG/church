{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || !root.child('admins').exists())"
      }
    },

    "config": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },

    "announcements": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".indexOn": ["timestamp"]
    },

    "sermons": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },

    "rooms": {
      ".read": "auth != null",
      ".indexOn": ["timestamp"],
      "$roomId": {
        ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || !data.exists() || newData.child('joined').val() === data.child('joined').val() + 1 || newData.child('joined').val() === data.child('joined').val() - 1)"
      }
    },

    "prayers": {
      ".read": "auth != null",
      ".indexOn": ["timestamp"],
      "$prayerId": {
        ".write": "auth != null && (!data.exists() || data.child('createdBy').val() === auth.uid || root.child('admins').child(auth.uid).exists() || newData.child('count').val() === data.child('count').val() + 1)"
      }
    },

    "prayedBy": {
      ".read": "auth != null",
      "$prayerId": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },

    "applications": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".indexOn": ["timestamp"],
      "$id": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || data.child('userUid').val() === auth.uid)",
        ".write": "auth != null && (!data.exists() || root.child('admins').child(auth.uid).exists())"
      }
    },

    "fcmTokens": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "_seed": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}

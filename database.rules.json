{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && (root.child('admins').child(auth.uid).exists() || !root.child('admins').exists())"
      }
    },

    "config": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },

    "announcements": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".indexOn": ["timestamp"]
    },

    "sermons": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },

    "bulletins": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".indexOn": ["timestamp"]
    },

    "rooms": {
      ".read": "auth != null",
      ".indexOn": ["timestamp"],
      "$roomId": {
        ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || !data.exists() || newData.child('joined').val() === data.child('joined').val() + 1 || newData.child('joined').val() === data.child('joined').val() - 1)"
      }
    },

    "prayers": {
      ".read": "auth != null",
      ".indexOn": ["timestamp"],
      "$prayerId": {
        ".write": "auth != null && (!data.exists() || data.child('createdBy').val() === auth.uid || root.child('admins').child(auth.uid).exists() || (newData.child('count').val() === data.child('count').val() + 1 && newData.child('text').val() === data.child('text').val() && newData.child('createdBy').val() === data.child('createdBy').val() && newData.child('timestamp').val() === data.child('timestamp').val()))"
      }
    },

    "prayedBy": {
      ".read": "auth != null",
      "$prayerId": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },

    "applications": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".indexOn": ["timestamp"],
      "$id": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || data.child('userUid').val() === auth.uid)",
        ".write": "auth != null && ((!data.exists() && newData.child('userUid').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('userUid').val() === auth.uid) || root.child('admins').child(auth.uid).exists())"
      }
    },

    "fcmTokens": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "gallery": {
      ".read": true,
      ".indexOn": ["timestamp"],
      "$id": {
        ".write": "auth != null && (!data.exists() || root.child('admins').child(auth.uid).exists() || data.child('uploaderUid').val() === auth.uid)"
      }
    },

    "events": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".indexOn": ["date"]
    },

    "_seed": {
      ".read": "auth != null",
      "$key": {
        ".write": "auth != null && !data.exists()"
      }
    }
  }
}

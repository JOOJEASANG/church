rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isApprovedMember() {
      return signedIn() && (request.auth.token.memberApproved == true || isAdmin());
    }

    function validImage(maxBytes) {
      return request.resource != null
        && request.resource.size <= maxBytes
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    function validBulletin() {
      return request.resource != null
        && request.resource.size <= 20 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf'
          || request.resource.contentType.matches('image/(jpeg|png|webp|gif)'));
    }

    match /bulletins/{fileName} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && validBulletin();
      allow delete: if isAdmin();
    }

    match /img/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && validImage(10 * 1024 * 1024);
      allow delete: if isAdmin();
    }

    // 신규 게시물 이미지는 UID 경로와 ownerUid 메타데이터를 함께 사용합니다.
    match /posts/{uid}/{fileName} {
      allow read: if signedIn();
      allow create: if isApprovedMember()
        && request.auth.uid == uid
        && validImage(6 * 1024 * 1024)
        && request.resource.metadata.ownerUid == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin() || (isApprovedMember() && request.auth.uid == uid);
    }

    // 기존 배포본이 생성한 평면 경로는 읽기만 허용합니다.
    // DB 항목 삭제 시 Cloud Function이 관리자 권한으로 파일을 정리합니다.
    match /posts/{legacyFileName} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /gallery/{uid}/{fileName} {
      allow read: if true;
      allow create: if isApprovedMember()
        && request.auth.uid == uid
        && validImage(6 * 1024 * 1024)
        && request.resource.metadata.ownerUid == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin() || (isApprovedMember() && request.auth.uid == uid);
    }

    match /gallery/{legacyFileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
